{
  "functions": [
    {
      "source": "functions",
      "codebase": "web",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "lib-test", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": [
    {
      "target": "web",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/lists{,/**}",
          "function": {
            "functionId": "lists",
            "region": "europe-west1"
          }
        },
        {
          "source": "/3/search/**",
          "function": {
            "functionId": "tmdb",
            "region": "europe-west1"
          }
        },
        {
          "source": "/adoptGuestCredits",
          "function": {
            "functionId": "adoptGuestCredits",
            "region": "europe-west1"
          }
        },
        {
          "source": "/boards{,/**}",
          "function": {
            "functionId": "boards",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "web",
            "region": "europe-west1"
          }
        },
        {
          "source": "/l/**",
          "function": {
            "functionId": "web",
            "region": "europe-west1"
          }
        },
        {
          "source": "/r/**",
          "function": {
            "functionId": "web",
            "region": "europe-west1"
          }
        },
        {
          "source": "/og/**",
          "function": {
            "functionId": "web",
            "region": "europe-west1"
          }
        },
        {
          "source": "/img/**",
          "function": {
            "functionId": "web",
            "region": "europe-west1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            }
          ]
        },
        {
          "regex": "^/(?:[^_].*|_|_[^_].*|__|__[^/].*)?$",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "script-src 'self' 'sha256-2iKKgy5SB11PUVBbbTyzt+UMR84yVQVKvL8ExeCn51k=' 'sha256-r5OZZkdnE7YDlM+2flIVbVo7t4hz5lUfP+HnhdDS8Gs=' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; report-uri /api/csp-report"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/@(new|search|me|c|settings|mod|u|about|b|boards|s|trash|following|admin){,/**}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        }
      ]
    }
  ]
}
