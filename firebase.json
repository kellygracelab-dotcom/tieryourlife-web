{
  "functions": [
    {
      "source": "functions",
      "codebase": "web",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "lib-test", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": [
    {
      "target": "web",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/lists{,/**}",
          "function": { "functionId": "lists", "region": "europe-west1" }
        },
        {
          "source": "/3/search/**",
          "function": { "functionId": "tmdb", "region": "europe-west1" }
        },
        {
          "source": "/adoptGuestCredits",
          "function": { "functionId": "adoptGuestCredits", "region": "europe-west1" }
        },
        {
          "source": "/api/**",
          "function": { "functionId": "web", "region": "europe-west1" }
        },
        {
          "source": "/l/**",
          "function": { "functionId": "web", "region": "europe-west1" }
        },
        {
          "source": "/r/**",
          "function": { "functionId": "web", "region": "europe-west1" }
        },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
