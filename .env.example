# Copy to .env.local (git-ignored). Both are optional: without a site key the
# site runs without App Check, which is what fixtures and the emulator need.
VITE_RECAPTCHA_SITE_KEY=
# Development only: a debug token registered in Firebase console > App Check.
# No VITE_ prefix on purpose: Vite copies VITE_* variables into the published
# bundle. Only the dev server hands this one to the code, and a build stops if
# the old VITE_APPCHECK_DEBUG_TOKEN is still set.
APPCHECK_DEBUG_TOKEN=
